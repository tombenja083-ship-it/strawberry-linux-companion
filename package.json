{
  "name": "strawberry-linux-companion",
  "version": "0.1.0",
  "description": "A Linux-friendly AI browser companion inspired by Strawberry's workflow.",
  "main": "src/main.js",
  "author": {
    "name": "Local project",
    "email": "local@example.invalid"
  },
  "homepage": "https://github.com/tombenja083-ship-it/strawberry-linux-companion",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "check": "node scripts/check.js",
    "test": "npm run check",
    "smoke": "node scripts/smoke.js",
    "dist": "electron-builder --linux AppImage deb",
    "dist:appimage": "electron-builder --linux AppImage",
    "dist:deb": "electron-builder --linux deb"
  },
  "devDependencies": {
    "electron": "^44.1.1",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.local.strawberrycompanion",
    "productName": "Strawberry Linux Companion",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Utility",
      "icon": "assets/icon.svg"
    }
  }
}
